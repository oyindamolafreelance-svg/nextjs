# --- Supabase (required) ---
# From your Supabase project: Settings → API.
# The URL and anon key are safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Service-role key: SERVER-ONLY, never exposed to the browser. It bypasses
# Row Level Security and is used only by the scheduled cron route that
# expires stale job listings. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=""

# --- AI job-posting auto-fill (required for the admin auto-fill helper) ---
# Anthropic API key. Without it, the admin can still fill the job form
# manually; only the "auto-fill from pasted text" button needs this.
ANTHROPIC_API_KEY=""
# Model used to parse pasted job text into structured fields.
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Cron (required for the auto-expire job to actually fire) ---
# Random secret. Vercel Cron sends `Authorization: Bearer <CRON_SECRET>`.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- App URL (optional) ---
# Fixed public URL of this deployment. Defaults to the Vercel-provided
# *.vercel.app URL. Set a custom domain here later with no code changes.
NEXT_PUBLIC_SITE_URL=""
