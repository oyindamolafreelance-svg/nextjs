# --- Supabase (required) ---
# From your Supabase project: Settings → API.
# The URL and anon key are safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Service-role key: SERVER-ONLY, never exposed to the browser. It bypasses
# Row Level Security and is used only by the scheduled cron route that
# expires stale job listings. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=""

# --- AI job-posting auto-fill (optional; powers the admin auto-fill button) ---
# Set EITHER provider — whichever key is present is used (Gemini preferred).
# Without either, the admin just fills the job form manually.
#
# Google Gemini — has a free tier (no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
#
# Anthropic Claude — pay-as-you-go: https://console.anthropic.com
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Cron (required for the auto-expire job to actually fire) ---
# Random secret. Vercel Cron sends `Authorization: Bearer <CRON_SECRET>`.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- App URL (optional) ---
# Fixed public URL of this deployment. Defaults to the Vercel-provided
# *.vercel.app URL. Set a custom domain here later with no code changes.
NEXT_PUBLIC_SITE_URL=""
